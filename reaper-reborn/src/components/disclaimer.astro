<div class="container disclaimer-box main">
    <p id="disclaimerToggle">Disclaimer</p>
    <div id="disclaimerText" class="hidden">
        AudioReaper relies on NLP and Spotify's API, so results may be
        inconsistent at times. We're working on ways to achieve better results,
        whether that's by streamlining data-processing or improving matching
        algorithms.
    </div>
</div>

<script>
    document
        .getElementById("disclaimerToggle")
        ?.addEventListener("click", disclaimerToggle);

    // Toggle the class, and hide it after 7 seconds
    function disclaimerToggle() {
        const disclaimerText = document.getElementById("disclaimerText");
        if (disclaimerText) {
            disclaimerText.classList.toggle("hidden");
            if (!disclaimerText.classList.contains("hidden")) {
                setTimeout(() => {
                    disclaimerText.classList.toggle("hidden");
                }, 7000);
            }
        }
    }
</script>
