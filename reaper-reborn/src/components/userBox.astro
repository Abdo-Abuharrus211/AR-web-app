---
import spotifyLogo from "../assets/images/Spotify_Primary_Logo_RGB_Green.png";
import Image from "astro/components/Image.astro";
---

<div class="container center">
    <div class="flex column">
        <label
            data-tooltip="AudioReaper needs your account info to add songs to your specified playlist."
            for="login-btn"
            id="login-label">Please log into Spotify.</label
        >
        <p id="user-name" class="hidden"></p>
        <button id="login-btn" class="outline contrast login-button">
            <Image src={spotifyLogo} alt alt="Spotify logo" />
            Log in
        </button>
        <button id="logout-btn" class="outline contrast logout-button" hidden>
            <Image src={spotifyLogo} alt alt="Spotify logo" />
            Log Out
        </button>
    </div>
</div>

<script>
    import { checkLoginStatus } from "../scripts/user";
    import { APIBaseURL } from "../constants";

    document.getElementById("login-btn")?.addEventListener("click", loginUser);
    document
        .getElementById("logout-btn")
        ?.addEventListener("click", logoutUser);

    // TODO: fix this session manmagement to be PROPER and airtight!
    async function loginUser() {
        try {
            const response = await fetch(`${APIBaseURL}/login`, {
                method: "GET",
            });

            if (response.ok) {
                let res = await response.json();
                window.location = res.auth_url;
            }
        } catch (error) {
            console.log(`Error authenticating: ${error}`);
        }
    }

    async function logoutUser() {
        try {
            const response = await fetch(`${APIBaseURL}/logout`, {
                method: "POST",
                credentials: "include",
            });
            if (response.ok) {
                sessionStorage.clear();
                window.location.href = "/";
                checkLoginStatus();
            }
        } catch (error) {
            console.log(`Error logging out: ${error}`);
        }
    }
</script>

<style>
    .login-button img,
    .logout-button img {
        width: 24px;
        height: auto;
        margin-right: var(--spacing2);
    }
</style>
