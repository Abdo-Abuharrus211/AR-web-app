``;
---

<dialog id="contact-modal" class="hidden" open>
    <article>
        <header>
            <!-- Removed `rel="prev" from this btn so be aware if side effects arise` -->
            <h2>Contact Us</h2>
            <button id="close-contact-modal" aria-label="Close">X</button>
        </header>
        <p>
            If you have any questions or concerns, please fill out the form
            below.
        </p>
        <form>
            <label for="name">Your Name:</label>
            <input type="text" id="name" name="name" required />
            <label for="email">Your Email:</label>
            <input type="email" id="email" name="email" required />
            <label for="message">Message:</label>
            <textarea id="message" name="message" rows="4" required></textarea>
            <button type="submit" class="outline">Send Message</button>
        </form>
    </article>
</dialog>

<script>
    import { attachModalLogic } from "../scripts/modalHandler";

    document.addEventListener("DOMContentLoaded", () => {
        attachModalLogic(
            ".contact-trigger",
            "contact-modal",
            "#close-contact-modal",
        );
    });
</script>
