---
import Image from "astro/components/Image.astro";
import bannerImage from "../assets/images/pexels-tuesday-temptation-190692-3780104.jpg";
---

<header style="padding-top: 0;">
    <div class="banner container-fluid">
        <Image src={bannerImage} alt={"banner image"} />
        <div class="banner-text">
            Bridge your Local library with your Spotify!
        </div>
    </div>
    <small
        >Art by <a
            id="artist-link"
            href="https://www.pexels.com/photo/purple-and-blue-light-digital-wallpaper-3780104/"
            >Tuesday Temptation</a
        ></small
    >
</header>

<style>
    .banner {
        padding: 0;
        position: relative;
        width: 100%;
        height: var(--banner-height);
        overflow: hidden;
    }

    .banner img.banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .banner .banner-text {
        position: absolute;
        top: 60%;
        left: 40%;
        transform: translate(-20%, -50%);
        color: var(--text);
        font-size: 2.5rem;
        text-align: center;
        z-index: 5;
    }

    /* Artist link styles preserved */
    #artist-link {
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
    }
    #artist-link:hover {
        color: var(--accent);
    }
</style>
