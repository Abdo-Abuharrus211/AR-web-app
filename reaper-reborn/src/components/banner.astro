---
import Image from "astro/components/Image.astro";
import bannerImage from "../assets/images/pexels-tuesday-temptation-190692-3780104.jpg";
import IntroSection from "./introSection.astro";
---

<div class="container-fluid">
    <section>
        <!-- TODO: replace the banner background with and style the span -->
        <!-- <Image src={bannerImage} alt={"banner image"} /> -->
        <div>
            <h2 class="greeting">
                Bridge your Local library with your <span
                    ><em> Spotify! </em>
                </span>
            </h2>
        </div>
    </section>
    <IntroSection />
    <!-- <p>
        Art by <a
            id="artist-link"
            href="https://www.pexels.com/photo/purple-and-blue-light-digital-wallpaper-3780104/"
            >Tuesday Temptation</a>
    </p> -->
</div>

<style>
    .banner {
        padding: 0;
        position: relative;
        width: 100%;
        height: var(--banner-height);
        overflow: hidden;
    }

    .banner img.banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .banner .banner-text {
        position: absolute;
        top: 20%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: var(--text);
        font-size: calc(var(--spacing5));
        line-height: 1.5;
        text-align: center;
    }
    .greeting {
        color: var(--text);
        font-size: calc(var(--spacing5));
        line-height: 1.5;
    }

    #artist-link {
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
    }
    #artist-link:hover {
        color: var(--accent);
    }
</style>
