---
import UserBox from "./userBox.astro";

// import "../scripts/fileIO.ts";
---

<section class="margin7">
    <UserBox />
    <div id="drop-zone" class="folder-not-added">
        <p id="folder-name" class="hidden"></p>
        <p>Drag and drop a folder or select</p>
        <!-- Following ignore is for the webdirecory attribute -->
        <!-- @ts-ignore -->
        <input
        @ts-ignore
        type="file"
        id="folderInput"
        multiple
        accept="audio/mp3"
        webkitdirectory
        directory
        style="display:none"
        />
        <button onclick="document.getElementById('folderInput').click();"
        >Browse...</button
        >
    </div>
    <div class="container flex-column form-box">
        <input
        id="playlist-input"
        type="text"
        class="playlist-form"
        name="playlistName"
        placeholder="Playlist name..."
        aria-label="playlistName"
        />
        <button id="harvest-btn" class="outline" disabled="true">Harvest!</button>
        <form>
            <!-- loading animation -->
            <dialog id="loadingIndicator" class="hidden" open>
                <article class="center">
                    <h4>AudioReaper is processing your library!</h4>
                    <div class="loader"></div>
                </article>
            </dialog>
            <dialog id="successIndicator" class="hidden" open>
                <article>
                    <h3>Tracks added to Playlist!</h3>
                </article>
            </dialog>
        </form>
    </div>
</section>
    
    <script src="../scripts/fileIO.ts"></script>
    
    <style>
        #drop-zone {
            color: var(--text);
            margin: 2% 10%;
        border-radius: 5px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
    }

    #drop-zone:hover {
        border-color: var(--secondary);
        opacity: 0.8;
    }

    #folder-name {
        color: var(--text);
    }

    #harvest-btn {
        margin: 5%;
        color: var(--text);
    }
    #harvest-btn:hover {
        border-color: var(--secondary);
    }

    /* Loader */
    .loader {
        margin: auto;
        width: 45px;
        aspect-ratio: 1;
        --c: no-repeat linear-gradient(var(--secondary) 0 0);
        background:
            var(--c) 0% 100%,
            var(--c) 50% 100%,
            var(--c) 100% 100%;
        animation: l2 1s infinite linear;
    }
    .playlist-form {
        width: 40%;
        margin: 3% auto;
    }
</style>
